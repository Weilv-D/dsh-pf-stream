{
  "name": "dsh-pf-stream",
  "version": "0.3.0",
  "description": "DeepSeek Harness video understanding plugin: adaptive dual-scale streaming sampling plus deterministic inspection, with subtitles or transcribed speech and a self-service setup panel.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Weilv-D/dsh-pf-stream"
  },
  "homepage": "https://github.com/Weilv-D/dsh-pf-stream#readme",
  "bugs": {
    "url": "https://github.com/Weilv-D/dsh-pf-stream/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "client.js",
    "locale/zh.json",
    "locale/en.json",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:host": "node scripts/verify-host-contract.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["slots"]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "video",
    "vision",
    "ffmpeg"
  ],
  "license": "Apache-2.0"
}
